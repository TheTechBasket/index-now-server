<div class="space-y-6" id="site-urls-page" data-site-id="<%= siteId %>">
  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm">
    <a href="/" class="text-muted-foreground hover:text-foreground transition-colors">
      <svg class="size-4 inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Sites
    </a>
    <svg class="size-3 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m9 18 6-6-6-6"/></svg>
    <span class="font-medium" id="site-name"><%= siteName %></span>
  </div>

  <!-- Site header (populated by JS) -->
  <div id="site-header" class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight" id="site-title"><%= siteName %></h1>
        <span id="key-badge" class="hidden inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium"></span>
        <span id="level-badge" class="hidden inline-flex items-center rounded-md bg-muted px-2 py-0.5 text-xs font-normal text-muted-foreground"></span>
      </div>
      <p class="mt-1 text-xs text-muted-foreground" id="site-host">Loading...</p>
    </div>
    <div class="flex flex-wrap items-center gap-2" id="site-actions">
      <button id="btn-site-settings" class="inline-flex items-center gap-1.5 rounded-md border bg-background px-3 py-1.5 text-xs font-medium transition-colors hover:bg-accent cursor-pointer">
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        Site Settings
      </button>
      <button id="btn-custom-url" class="inline-flex items-center gap-1.5 rounded-md border bg-background px-3 py-1.5 text-xs font-medium transition-colors hover:bg-accent cursor-pointer">
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Custom URL
      </button>
    </div>
  </div>

  <!-- Key verification warning with key file helper (shown by JS if needed) -->
  <div id="key-warning" class="hidden rounded-lg border border-amber-500/40 bg-amber-500/10 p-4">
    <div class="flex items-start gap-3">
      <svg class="size-5 shrink-0 text-amber-500 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
      <div class="flex-1">
        <p class="font-medium text-amber-800 dark:text-amber-200">IndexNow key not verified</p>
        <p class="text-sm text-amber-700 dark:text-amber-300 mt-1">Deploy your key file before submitting URLs.</p>
        <div id="key-file-helper" class="mt-3 space-y-2">
          <p class="text-xs font-medium text-amber-800 dark:text-amber-200">Key file content:</p>
          <pre id="key-file-content" class="rounded-md border border-amber-500/30 bg-background px-3 py-2 text-xs font-mono select-all"></pre>
          <p class="text-xs text-amber-700 dark:text-amber-300">
            Save as <code id="key-filename" class="rounded bg-amber-500/20 px-1 text-[11px]"></code> at your domain root. File must contain only the key string, no quotes, no newline.
          </p>
          <div class="flex items-center gap-2">
            <button id="copy-key-content" class="inline-flex items-center gap-1 rounded-md border border-amber-500/40 bg-amber-500/20 px-2 py-1 text-[11px] font-medium text-amber-800 dark:text-amber-200 transition-colors hover:bg-amber-500/30 cursor-pointer">Copy content</button>
            <button id="copy-key-filename" class="inline-flex items-center gap-1 rounded-md border border-amber-500/40 bg-amber-500/20 px-2 py-1 text-[11px] font-medium text-amber-800 dark:text-amber-200 transition-colors hover:bg-amber-500/30 cursor-pointer">Copy filename</button>
            <button id="download-key-file" class="inline-flex items-center gap-1 rounded-md border border-amber-500/40 bg-amber-500/20 px-2 py-1 text-[11px] font-medium text-amber-800 dark:text-amber-200 transition-colors hover:bg-amber-500/30 cursor-pointer">
              <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              Download
            </button>
            <button id="verify-key-btn" class="inline-flex items-center gap-1 rounded-md border border-amber-500/40 bg-amber-500/20 px-3 py-1 text-[11px] font-medium text-amber-800 dark:text-amber-200 transition-colors hover:bg-amber-500/30 cursor-pointer">Verify Key</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sync error banner (shown by JS after failed sync) -->
  <div id="sync-error" class="hidden rounded-lg border border-destructive/30 bg-destructive/10 p-3 text-xs">
    <p class="flex items-center gap-1.5 font-semibold text-destructive">
      <svg class="size-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
      Sitemap sync failed
    </p>
    <p id="sync-error-msg" class="mt-1 text-muted-foreground"></p>
    <div id="sync-error-suggest" class="hidden mt-2 flex flex-wrap items-center gap-2">
      <span id="sync-error-url" class="font-mono text-[11px] break-all"></span>
      <button id="sync-error-fix" class="inline-flex items-center rounded-md bg-destructive/20 border border-destructive/30 px-2 py-1 text-[11px] font-medium text-destructive hover:bg-destructive/30 cursor-pointer">Use this sitemap</button>
      <button id="sync-error-dismiss" class="inline-flex items-center rounded-md border px-2 py-1 text-[11px] font-medium hover:bg-accent cursor-pointer">Dismiss</button>
    </div>
    <p id="sync-error-final" class="hidden mt-1 font-mono text-[11px]"></p>
    <button id="sync-error-dismiss-plain" class="hidden mt-2 inline-flex items-center rounded-md border px-2 py-1 text-[11px] font-medium hover:bg-accent cursor-pointer">Dismiss</button>
  </div>

  <!-- Redirect warning banner (shown by JS after sync detects redirect) -->
  <div id="redirect-warning" class="hidden rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-xs">
    <p class="flex items-center gap-1.5 font-semibold text-amber-700 dark:text-amber-300">
      <svg class="size-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
      Sitemap redirected
    </p>
    <p class="mt-1 text-muted-foreground">
      Your sitemap URL redirected from <span id="redirect-from" class="font-mono break-all"></span> to <span id="redirect-to" class="font-mono break-all"></span>
    </p>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <button id="redirect-fix" class="inline-flex items-center rounded-md bg-amber-500/20 border border-amber-500/30 px-2 py-1 text-[11px] font-medium text-amber-800 dark:text-amber-200 hover:bg-amber-500/30 cursor-pointer">Update to final URL</button>
      <button id="redirect-dismiss" class="inline-flex items-center rounded-md border px-2 py-1 text-[11px] font-medium hover:bg-accent cursor-pointer">Dismiss</button>
    </div>
  </div>

  <!-- Host mismatch warning (shown by JS when URLs don't match site host) -->
  <div id="mismatch-warning" class="hidden rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-xs">
    <p class="flex items-center gap-1.5 font-semibold text-amber-700 dark:text-amber-300">
      <svg class="size-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
      <span id="mismatch-text"></span>
    </p>
    <p class="mt-1 text-muted-foreground">Fix your sitemap or site host. These URLs will be flagged and blocked from manual submission.</p>
  </div>

  <!-- Toolbar: search + status filter + actions -->
  <div class="flex flex-wrap items-center gap-2">
    <div class="relative">
      <svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        id="url-search"
        type="text"
        placeholder="Search URLs..."
        aria-label="Search URLs"
        class="h-8 w-64 rounded-md border bg-background pl-9 pr-3 text-xs outline-none ring-ring focus:ring-2"
      />
    </div>
    <select id="url-status-filter" aria-label="Filter by status" class="h-8 rounded-md border bg-background px-2 text-xs outline-none ring-ring focus:ring-2 cursor-pointer">
      <option value="all">All statuses</option>
      <option value="new">New</option>
      <option value="updated">Updated</option>
      <option value="submitted">Submitted</option>
      <option value="removed">Removed</option>
    </select>
    <span id="urls-loading" class="hidden size-4 animate-spin text-muted-foreground" role="status" aria-label="Loading URLs">
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="4"/><path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
    </span>
    <div class="ml-auto flex items-center gap-2">
      <label for="url-page-size" class="text-xs text-muted-foreground">Per page</label>
      <select id="url-page-size" class="h-7 rounded-md border bg-background px-1.5 text-xs outline-none ring-ring focus:ring-2 cursor-pointer">
        <option value="20">20</option>
        <option value="30">30</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
      <span id="url-page-info" class="text-xs text-muted-foreground"></span>
      <button id="url-prev" aria-label="Previous page" class="inline-flex size-7 items-center justify-center rounded-md border text-xs disabled:opacity-50 cursor-pointer" disabled>&lt;</button>
      <button id="url-next" aria-label="Next page" class="inline-flex size-7 items-center justify-center rounded-md border text-xs disabled:opacity-50 cursor-pointer" disabled>&gt;</button>
    </div>
  </div>

  <!-- Site actions row -->
  <div class="flex flex-wrap items-center gap-2">
    <button id="btn-sitemaps" class="hidden items-center gap-1.5 rounded-md border bg-background px-3 py-1.5 text-xs font-medium transition-colors hover:bg-accent cursor-pointer">
      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
      <span class="btn-label">Sitemaps</span>
    </button>
    <button id="btn-sync" class="inline-flex items-center gap-1.5 rounded-md border bg-background px-3 py-1.5 text-xs font-medium transition-colors hover:bg-accent cursor-pointer disabled:opacity-60">
      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
      <span class="btn-label">Sync Sitemap</span>
    </button>
    <button id="btn-submit" class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground transition-colors hover:bg-primary/90 cursor-pointer disabled:opacity-60">
      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
      <span class="btn-label">Submit Pending</span>
      <span id="submit-count" class="hidden rounded-full bg-primary-foreground/25 px-1.5 py-px text-[10px] font-semibold"></span>
    </button>
    <button id="btn-reset" class="inline-flex items-center gap-1.5 rounded-md border bg-background px-3 py-1.5 text-xs font-medium transition-colors hover:bg-accent cursor-pointer disabled:opacity-60">
      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
      <span class="btn-label">Reset Statuses</span>
    </button>
    <button id="btn-prune" class="inline-flex items-center gap-1.5 rounded-md border border-destructive/30 bg-background px-3 py-1.5 text-xs font-medium text-destructive transition-colors hover:bg-destructive/10 cursor-pointer disabled:opacity-60">
      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
      <span class="btn-label">Prune Removed</span>
    </button>
  </div>

  <!-- Bulk actions bar (shown when URLs selected) -->
  <div id="bulk-bar" class="hidden flex flex-wrap items-center gap-2 rounded-md border bg-muted/40 px-3 py-1.5 text-xs">
    <span id="bulk-count" class="font-medium"></span>
    <button id="bulk-select-all" class="hidden items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium hover:bg-accent cursor-pointer">Select all matching</button>
    <button id="bulk-submit" class="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium hover:bg-accent cursor-pointer">
      <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
      Submit selected
    </button>
    <button id="bulk-delete" class="inline-flex items-center gap-1 rounded-md border border-destructive/30 px-2 py-1 text-xs font-medium text-destructive hover:bg-destructive/10 cursor-pointer">
      <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
      Delete selected
    </button>
    <button id="bulk-clear" class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium hover:bg-accent cursor-pointer">Clear</button>
  </div>

  <!-- URL table -->
  <div id="url-table-wrap" class="rounded-lg border" style="max-height:520px;overflow:auto">
    <table class="w-full text-sm" id="url-table" aria-busy="false">
      <thead class="sticky top-0 z-10 bg-muted">
        <tr class="border-b">
          <th scope="col" class="w-8 px-2 py-2"><input type="checkbox" id="select-all" aria-label="Select all URLs on this page" class="rounded cursor-pointer" /></th>
          <th scope="col" class="px-3 py-2 text-left font-medium">URL</th>
          <th scope="col" class="px-3 py-2 text-left font-medium">Status</th>
          <th scope="col" class="px-3 py-2 text-left font-medium">Lastmod</th>
          <th scope="col" class="px-3 py-2 text-left font-medium">Last seen</th>
          <th scope="col" class="px-3 py-2 text-left font-medium">Submitted</th>
          <th scope="col" class="px-3 py-2 text-right font-medium">Actions</th>
        </tr>
      </thead>
      <tbody id="url-tbody">
        <tr><td colspan="7" class="px-3 py-8 text-center text-muted-foreground">Loading URLs...</td></tr>
      </tbody>
    </table>
  </div>

<!-- Site Settings dialog -->
<dialog id="site-settings-dialog" class="w-full max-w-md rounded-lg border bg-background p-0 shadow-lg backdrop:bg-black/50">
  <form id="site-settings-form" class="p-6">
    <h2 class="text-lg font-semibold mb-1">Edit site</h2>
    <p class="text-sm text-muted-foreground mb-4">Update site details and submission policy.</p>
    <div class="grid gap-4">
      <div class="grid gap-1.5">
        <label for="edit-name" class="text-sm font-medium">Name</label>
        <input id="edit-name" name="name" required class="h-9 w-full rounded-md border bg-background px-3 text-sm outline-none ring-ring focus:ring-2" />
      </div>
      <div class="grid gap-1.5">
        <label for="edit-host" class="text-sm font-medium">Host</label>
        <input id="edit-host" name="host" required class="h-9 w-full rounded-md border bg-background px-3 text-sm outline-none ring-ring focus:ring-2" />
      </div>
      <div class="grid gap-1.5">
        <label for="edit-sitemap" class="text-sm font-medium">Sitemap URL</label>
        <input id="edit-sitemap" name="sitemapUrl" type="url" required class="h-9 w-full rounded-md border bg-background px-3 text-sm outline-none ring-ring focus:ring-2" />
      </div>
      <div class="grid gap-1.5">
        <label for="edit-key" class="text-sm font-medium">IndexNow key</label>
        <input id="edit-key" name="apiKey" pattern="[a-zA-Z0-9\-]{8,128}" class="h-9 w-full rounded-md border bg-background px-3 text-sm outline-none ring-ring focus:ring-2" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="grid gap-1.5">
          <label for="edit-level" class="text-sm font-medium">Submission level</label>
          <select id="edit-level" name="submissionLevel" class="h-9 rounded-md border bg-background px-2 text-sm outline-none ring-ring focus:ring-2 cursor-pointer">
            <option value="manual">Manual</option>
            <option value="scheduled">Scheduled</option>
            <option value="webhook">Webhook</option>
          </select>
        </div>
        <div id="edit-cron-wrap" class="hidden grid gap-1.5">
          <label for="edit-cron" class="text-sm font-medium">Interval</label>
          <select id="edit-cron" name="cronInterval" class="h-9 rounded-md border bg-background px-2 text-sm outline-none ring-ring focus:ring-2 cursor-pointer">
            <option value="hourly">Hourly</option>
            <option value="6h">Every 6 hours</option>
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
          </select>
        </div>
      </div>
      <div class="flex items-center justify-between border-t pt-4">
        <button type="button" id="btn-delete-site" class="rounded-md bg-destructive px-3 py-1.5 text-xs font-medium text-destructive-foreground hover:bg-destructive/90 cursor-pointer">Delete site</button>
        <div class="flex gap-2">
          <button type="button" id="btn-settings-cancel" class="rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent cursor-pointer">Cancel</button>
          <button type="submit" class="rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90 cursor-pointer">Save changes</button>
        </div>
      </div>
      <div class="rounded-md border border-destructive/30 bg-destructive/5 p-3">
        <p class="text-sm font-medium text-destructive">Danger zone</p>
        <p class="mt-1 text-xs text-muted-foreground">Delete every URL for this site. Type the site host (<code id="delete-all-host" class="font-mono"></code>) to enable.</p>
        <div class="mt-2 flex items-center gap-2">
          <input id="delete-all-confirm" type="text" autocomplete="off" placeholder="site host" aria-label="Type site host to confirm deletion" class="h-8 min-w-0 flex-1 rounded-md border bg-background px-2 text-xs font-mono outline-none ring-ring focus:ring-2" />
          <button type="button" id="btn-delete-all" disabled class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-destructive/30 bg-background px-3 py-1.5 text-xs font-medium text-destructive transition-colors hover:bg-destructive/10 cursor-pointer disabled:opacity-50">
            <span class="btn-label">Delete All URLs</span>
          </button>
        </div>
      </div>
    </div>
  </form>
</dialog>

<!-- Custom URL dialog -->
<dialog id="custom-url-dialog" class="w-full max-w-md rounded-lg border bg-background p-0 shadow-lg backdrop:bg-black/50">
  <form id="custom-url-form" class="p-6">
    <h2 class="text-lg font-semibold mb-1">Submit Custom URLs</h2>
    <p class="text-sm text-muted-foreground mb-4">Only URLs matching the site host can be submitted. One URL per line.</p>
    <div class="grid gap-3">
      <textarea id="custom-urls-input" rows="6" placeholder="https://example.com/page-1&#10;https://example.com/page-2" class="w-full rounded-md border bg-background px-3 py-2 text-xs font-mono outline-none ring-ring focus:ring-2"></textarea>
    </div>
    <div class="flex justify-end gap-2 mt-4">
      <button type="button" id="btn-custom-cancel" class="rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent cursor-pointer">Cancel</button>
      <button type="submit" id="btn-custom-submit" class="rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90 cursor-pointer">
        Submit URLs
      </button>
    </div>
  </form>
</dialog>

<!-- Sitemaps dialog -->
<dialog id="sitemap-dialog" aria-labelledby="sitemap-dialog-title" class="w-full max-w-lg rounded-lg border bg-background p-0 shadow-lg backdrop:bg-black/50">
  <div class="p-6">
    <h2 id="sitemap-dialog-title" class="text-lg font-semibold mb-1">Sitemaps</h2>
    <p class="text-sm text-muted-foreground mb-4">Uncheck a sitemap to exclude it from future syncs.</p>
    <div id="sitemap-list" class="space-y-1 max-h-72 overflow-y-auto rounded-md border p-2"></div>
    <div class="flex justify-end gap-2 mt-4">
      <button type="button" id="btn-sitemap-close" class="rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent cursor-pointer">Close</button>
    </div>
  </div>
</dialog>

<!-- Toast container -->
<div id="toast-container" role="status" aria-live="polite" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>

<script>
(function() {
  'use strict';
  var siteId = document.getElementById('site-urls-page').dataset.siteId;
  var PAGE_SIZES = [20, 30, 50, 100];
  var PAGE_SIZE = 20;
  var currentPage = 0;
  var currentQ = '';
  var currentStatus = 'all';
  var siteData = null;
  var selectedIds = new Set();
  var currentRows = [];
  var filterTotal = 0;
  var selectAllMatching = false;
  var matchFilter = { q: '', status: 'all' };

  function clearSelection() {
    selectedIds.clear();
    selectAllMatching = false;
    document.querySelectorAll('.row-select').forEach(function(cb) { cb.checked = false; });
    updateBulkBar();
  }

  function api(url, opts) {
    opts = opts || {};
    if (opts.body) opts.headers = Object.assign({ 'Content-Type': 'application/json' }, opts.headers || {});
    return fetch('/api' + url, opts).then(function(res) {
      return res.json().then(function(data) {
        if (!res.ok) throw new Error(data.error || 'Request failed');
        return data;
      });
    });
  }

  function toast(msg, type) {
    var el = document.createElement('div');
    el.className = 'animate-enter rounded-md border px-4 py-2 text-sm shadow-lg ' +
      (type === 'error' ? 'border-destructive/30 bg-destructive/10 text-destructive' :
       'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400');
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(function() { el.remove(); }, 3500);
  }

  var SPINNER_SVG = '<svg class="size-3.5 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="4"/><path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>';

  // Unified busy state: disable + spinner + label swap + aria-busy, restore on done.
  // Works on buttons whose text lives in a .btn-label span, or plain-text buttons.
  function setBusy(btn, busy, busyText) {
    if (!btn) return;
    if (busy) {
      if (btn.dataset.busy === '1') return;
      btn.dataset.busy = '1';
      btn.dataset.origHtml = btn.innerHTML;
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      var label = btn.querySelector('.btn-label');
      if (label) {
        if (!btn.querySelector('.busy-spinner')) {
          var sp = document.createElement('span');
          sp.className = 'busy-spinner inline-flex';
          sp.innerHTML = SPINNER_SVG;
          btn.insertBefore(sp, btn.firstChild);
        }
        // Hide the button's original icon(s) so only the spinner shows
        Array.prototype.forEach.call(btn.children, function(child) {
          if (!child.classList.contains('busy-spinner') && !child.classList.contains('btn-label') && !child.classList.contains('busy-hidden')) {
            child.classList.add('hidden');
            child.classList.add('busy-hidden');
          }
        });
        label.textContent = busyText || 'Working...';
      } else {
        btn.innerHTML = SPINNER_SVG + ' ' + esc(busyText || 'Working...');
      }
    } else {
      if (btn.dataset.busy !== '1') return;
      delete btn.dataset.busy;
      btn.disabled = false;
      btn.removeAttribute('aria-busy');
      if (btn.dataset.origHtml) btn.innerHTML = btn.dataset.origHtml;
      delete btn.dataset.origHtml;
    }
  }

  function fmt(d) {
    if (!d) return '';
    return new Date(d).toLocaleString();
  }

  function fmtRel(d) {
    if (!d) return '';
    var t = new Date(d).getTime();
    if (isNaN(t)) return '';
    var s = Math.max(0, Math.round((Date.now() - t) / 1000));
    if (s < 60) return 'just now';
    var m = Math.floor(s / 60);
    if (m < 60) return m + 'm ago';
    var h = Math.floor(m / 60);
    if (h < 24) return h + 'h ago';
    var d2 = Math.floor(h / 24);
    if (d2 < 30) return d2 + 'd ago';
    var mo = Math.floor(d2 / 30);
    if (mo < 12) return mo + 'mo ago';
    return Math.floor(mo / 12) + 'y ago';
  }

  // Table date cell: relative text, full timestamp on hover
  function fmtCell(d) {
    if (!d) return '';
    return '<span title="' + esc(fmt(d)) + '">' + fmtRel(d) + '</span>';
  }

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  var statusClasses = {
    new: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/30',
    updated: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30',
    submitted: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30',
    removed: 'bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/30',
  };

  // Load site info
  api('/sites/' + siteId).then(function(site) {
    siteData = site;
    document.getElementById('site-host').textContent = site.host;
    // Key badge
    var kb = document.getElementById('key-badge');
    kb.classList.remove('hidden');
    if (site.keyVerified) {
      kb.className = 'inline-flex items-center gap-1 rounded-full border border-emerald-500/30 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400';
      kb.innerHTML = '<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg> Key Verified';
    } else {
      kb.className = 'inline-flex items-center gap-1 rounded-full border border-amber-500/30 px-2 py-0.5 text-xs font-medium text-amber-600 dark:text-amber-400';
      kb.innerHTML = '<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg> Key Unverified';
      document.getElementById('key-warning').classList.remove('hidden');
    }
    // Level badge
    var lb = document.getElementById('level-badge');
    lb.classList.remove('hidden');
    if (site.submissionLevel === 'scheduled') {
      lb.textContent = 'Sched (' + (site.cronInterval || 'daily') + ')';
    } else {
      lb.textContent = site.submissionLevel;
    }
    // Populate key file helper
    if (site.apiKey) {
      document.getElementById('key-file-content').textContent = site.apiKey;
      document.getElementById('key-filename').textContent = site.apiKey + '.txt';
    }
    // Populate sitemap explorer
    if (site.sitemapChildren && site.sitemapChildren.length) {
      renderSitemapTree(site);
    }
    document.getElementById('btn-submit').disabled = !site.keyVerified;
  }).catch(function(err) {
    toast('Failed to load site: ' + err.message, 'error');
  });

  // Load URLs
  function loadUrls() {
    var params = 'limit=' + PAGE_SIZE + '&offset=' + (currentPage * PAGE_SIZE);
    if (currentQ) params += '&q=' + encodeURIComponent(currentQ);
    if (currentStatus !== 'all') params += '&status=' + currentStatus;

    document.getElementById('urls-loading').classList.remove('hidden');
    document.getElementById('url-table').setAttribute('aria-busy', 'true');

    api('/sites/' + siteId + '/urls?' + params).then(function(data) {
      document.getElementById('urls-loading').classList.add('hidden');
      document.getElementById('url-table').setAttribute('aria-busy', 'false');
      // Counts live in the status dropdown (single source of truth)
      var c = data.counts;
      var sf = document.getElementById('url-status-filter');
      function setOpt(v, t) { var o = sf.querySelector('option[value="' + v + '"]'); if (o) o.textContent = t; }
      setOpt('all', 'All (' + c.total + ')');
      setOpt('new', 'New (' + c.new + ')');
      setOpt('updated', 'Updated (' + c.updated + ')');
      setOpt('submitted', 'Submitted (' + c.submitted + ')');
      setOpt('removed', 'Removed (' + c.removed + ')');

      // Pending count rides on the primary action, not a passive stats row
      var sc = document.getElementById('submit-count');
      if (sc) {
        if (c.pending > 0) { sc.textContent = c.pending; sc.classList.remove('hidden'); }
        else sc.classList.add('hidden');
      }

      // Header stays a quiet one-liner: host + last sync
      var info = siteData ? siteData.host : '';
      if (data.lastSyncAt) info += ' · Last synced ' + fmt(data.lastSyncAt);
      document.getElementById('site-host').textContent = info;

      // Render rows
      currentRows = data.rows;
      filterTotal = data.total;
      // A new result set drops the cross-page selection unless it was just promoted for this filter
      if (selectAllMatching && (matchFilter.q !== currentQ || matchFilter.status !== currentStatus)) {
        selectAllMatching = false;
      }
      var tbody = document.getElementById('url-tbody');
      if (data.rows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="px-3 py-8 text-center text-muted-foreground">No URLs found.</td></tr>';
      } else {
        var pageIds = new Set(data.rows.map(function(r) { return r.id; }));
        selectedIds.forEach(function(id) { if (!pageIds.has(id)) selectedIds.delete(id); });
        tbody.innerHTML = data.rows.map(function(row) {
          var sc = statusClasses[row.status] || '';
          var checked = selectedIds.has(row.id) ? ' checked' : '';
          return '<tr class="border-b transition-colors hover:bg-muted/50">' +
            '<td class="px-2 py-2"><input type="checkbox" class="row-select rounded cursor-pointer" data-id="' + row.id + '"' + checked + ' /></td>' +
            '<td class="px-3 py-2 text-xs max-w-md truncate" title="' + esc(row.url) + '"><a href="' + esc(row.url) + '" target="_blank" rel="noreferrer" class="hover:underline">' + esc(row.url) + '</a></td>' +
            '<td class="px-3 py-2"><span class="inline-flex items-center rounded-md border px-1.5 h-5 text-[10px] font-medium ' + sc + '">' + row.status + '</span></td>' +
            '<td class="px-3 py-2 text-xs text-muted-foreground whitespace-nowrap">' + fmtCell(row.lastmod) + '</td>' +
            '<td class="px-3 py-2 text-xs text-muted-foreground whitespace-nowrap">' + fmtCell(row.lastSeenAt) + '</td>' +
            '<td class="px-3 py-2 text-xs text-muted-foreground whitespace-nowrap">' + fmtCell(row.submittedAt) + '</td>' +
            '<td class="px-3 py-2 text-right">' +
              '<div class="flex items-center justify-end gap-0.5">' +
                '<button class="row-action-submit size-7 inline-flex items-center justify-center rounded-md hover:bg-primary/10 text-primary cursor-pointer disabled:opacity-50" data-url="' + esc(row.url) + '" title="Submit to IndexNow" aria-label="Submit this URL to IndexNow">' +
                  '<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>' +
                '</button>' +
                '<button class="row-action-copy size-7 inline-flex items-center justify-center rounded-md hover:bg-accent cursor-pointer" data-url="' + esc(row.url) + '" title="Copy URL" aria-label="Copy URL">' +
                  '<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>' +
                '</button>' +
                '<a href="' + esc(row.url) + '" target="_blank" rel="noreferrer" class="size-7 inline-flex items-center justify-center rounded-md hover:bg-accent" title="Open" aria-label="Open URL in new tab">' +
                  '<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>' +
                '</a>' +
                '<button class="row-action-delete size-7 inline-flex items-center justify-center rounded-md hover:bg-destructive/10 text-destructive cursor-pointer disabled:opacity-50" data-id="' + row.id + '" title="Delete URL" aria-label="Delete this URL">' +
                  '<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>' +
                '</button>' +
              '</div>' +
            '</td>' +
            '</tr>';
        }).join('');
      }
      updateBulkBar();

      // Host mismatch warning (re-hidden on clean reloads)
      var mw = document.getElementById('mismatch-warning');
      if (data.warnings && data.warnings.mismatchedCount > 0) {
        mw.classList.remove('hidden');
        var mhost = siteData ? siteData.host : '';
        document.getElementById('mismatch-text').textContent =
          data.warnings.mismatchedCount + ' URL' + (data.warnings.mismatchedCount !== 1 ? 's' : '') +
          ' in sitemap do not match site host' + (mhost ? ' (' + mhost + ')' : '');
      } else {
        mw.classList.add('hidden');
      }

      // Pagination
      var totalPages = Math.ceil(data.total / PAGE_SIZE);
      document.getElementById('url-page-info').textContent =
        'Page ' + (currentPage + 1) + ' of ' + Math.max(1, totalPages) + ' · ' + data.total + ' URLs';
      document.getElementById('url-prev').disabled = currentPage === 0;
      document.getElementById('url-next').disabled = currentPage >= totalPages - 1;

      // Update URL params
      var p = new URLSearchParams();
      if (currentQ) p.set('q', currentQ);
      if (currentStatus !== 'all') p.set('status', currentStatus);
      if (PAGE_SIZE !== 20) p.set('limit', String(PAGE_SIZE));
      if (currentPage > 0) p.set('page', String(currentPage));
      var search = p.toString();
      var url = search ? window.location.pathname + '?' + search : window.location.pathname;
      window.history.replaceState({}, '', url);

      // Keep action buttons visible: reset table scroll to top on page/limit change
      var wrap = document.getElementById('url-table-wrap');
      if (wrap) wrap.scrollTop = 0;
    }).catch(function(err) {
      document.getElementById('urls-loading').classList.add('hidden');
      document.getElementById('url-table').setAttribute('aria-busy', 'false');
      document.getElementById('url-tbody').innerHTML =
        '<tr><td colspan="7" class="px-3 py-8 text-center text-destructive">' + esc(err.message) + '</td></tr>';
    });
  }

  // Read initial URL params
  var urlParams = new URLSearchParams(window.location.search);
  currentQ = urlParams.get('q') || '';
  currentStatus = urlParams.get('status') || 'all';
  currentPage = parseInt(urlParams.get('page') || '0') || 0;
  var initialLimit = parseInt(urlParams.get('limit') || localStorage.getItem('indexnow.site-urls.pageSize') || '20') || 20;
  if (PAGE_SIZES.indexOf(initialLimit) === -1) initialLimit = 20;
  PAGE_SIZE = initialLimit;
  document.getElementById('url-search').value = currentQ;
  document.getElementById('url-status-filter').value = currentStatus;
  document.getElementById('url-page-size').value = String(PAGE_SIZE);

  loadUrls();

  // Search debounce
  var searchTimer;
  document.getElementById('url-search').addEventListener('input', function() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function() {
      currentQ = document.getElementById('url-search').value.trim();
      currentPage = 0;
      loadUrls();
    }, 300);
  });

  // Status filter
  document.getElementById('url-status-filter').addEventListener('change', function() {
    currentStatus = this.value;
    currentPage = 0;
    loadUrls();
  });

  // Pagination
  document.getElementById('url-prev').addEventListener('click', function() {
    if (currentPage > 0) { currentPage--; loadUrls(); }
  });
  document.getElementById('url-next').addEventListener('click', function() {
    currentPage++;
    loadUrls();
  });

  // Per-page size
  document.getElementById('url-page-size').addEventListener('change', function() {
    PAGE_SIZE = parseInt(this.value) || 20;
    localStorage.setItem('indexnow.site-urls.pageSize', String(PAGE_SIZE));
    currentPage = 0;
    loadUrls();
  });

  // Keyboard shortcuts: / focus search, Esc clear, arrows paginate, Ctrl/Cmd+A select page
  document.addEventListener('keydown', function(e) {
    var tag = (e.target && e.target.tagName) || '';
    var typing = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    if (e.key === 'Escape') {
      var search = document.getElementById('url-search');
      if (document.activeElement === search && search.value) {
        search.value = '';
        currentQ = '';
        currentPage = 0;
        loadUrls();
      } else if (document.activeElement) {
        document.activeElement.blur();
      }
      return;
    }
    if (typing || e.ctrlKey || e.metaKey) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'a' && !typing) {
        e.preventDefault();
        var sa = document.getElementById('select-all');
        sa.checked = true;
        sa.dispatchEvent(new Event('change'));
      }
      return;
    }
    if (e.key === '/') {
      e.preventDefault();
      document.getElementById('url-search').focus();
    } else if (e.key === 'ArrowLeft') {
      if (currentPage > 0) { currentPage--; loadUrls(); }
    } else if (e.key === 'ArrowRight') {
      var nextBtn = document.getElementById('url-next');
      if (!nextBtn.disabled) { currentPage++; loadUrls(); }
    }
  });

  // Actions
  function fixSitemap(url, btn) {
    if (btn) setBusy(btn, true, 'Updating...');
    api('/sites/' + siteId + '/sitemap-fix', { method: 'POST', body: JSON.stringify({ sitemapUrl: url }) })
      .then(function() {
        toast('Sitemap URL updated');
        document.getElementById('sync-error').classList.add('hidden');
        document.getElementById('redirect-warning').classList.add('hidden');
        loadUrls();
      })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { if (btn) setBusy(btn, false); });
  }

  function showSyncError(err) {
    var el = document.getElementById('sync-error');
    el.classList.remove('hidden');
    document.getElementById('sync-error-msg').textContent = err.message;
    if (err.suggestedSitemap) {
      document.getElementById('sync-error-suggest').classList.remove('hidden');
      document.getElementById('sync-error-url').textContent = err.suggestedSitemap;
      document.getElementById('sync-error-dismiss-plain').classList.add('hidden');
    } else {
      document.getElementById('sync-error-suggest').classList.add('hidden');
      if (err.finalUrl) {
        var finalEl = document.getElementById('sync-error-final');
        finalEl.textContent = 'Final URL: ' + err.finalUrl;
        finalEl.classList.remove('hidden');
      }
      document.getElementById('sync-error-dismiss-plain').classList.remove('hidden');
    }
  }

  function showRedirectWarning(from, to) {
    var el = document.getElementById('redirect-warning');
    el.classList.remove('hidden');
    document.getElementById('redirect-from').textContent = from;
    document.getElementById('redirect-to').textContent = to;
  }

  document.getElementById('sync-error-fix').addEventListener('click', function() {
    var url = document.getElementById('sync-error-url').textContent;
    fixSitemap(url, this);
  });
  document.getElementById('sync-error-dismiss').addEventListener('click', function() {
    document.getElementById('sync-error').classList.add('hidden');
  });
  document.getElementById('sync-error-dismiss-plain').addEventListener('click', function() {
    document.getElementById('sync-error').classList.add('hidden');
  });
  document.getElementById('redirect-fix').addEventListener('click', function() {
    var url = document.getElementById('redirect-to').textContent;
    fixSitemap(url, this);
  });
  document.getElementById('redirect-dismiss').addEventListener('click', function() {
    document.getElementById('redirect-warning').classList.add('hidden');
  });

  document.getElementById('btn-sync').addEventListener('click', function() {
    var btn = this;
    setBusy(btn, true, 'Syncing...');
    document.getElementById('sync-error').classList.add('hidden');
    document.getElementById('redirect-warning').classList.add('hidden');
    api('/sites/' + siteId + '/sync', { method: 'POST' })
      .then(function(r) {
        toast('Synced: ' + (r.newCount || 0) + ' new, ' + (r.updatedCount || 0) + ' updated');
        if (r.redirected && r.finalUrl && siteData && r.finalUrl !== siteData.sitemapUrl) {
          showRedirectWarning(siteData.sitemapUrl, r.finalUrl);
        }
        loadUrls();
      })
      .catch(function(err) {
        var parsed;
        try { parsed = JSON.parse(err.message); } catch(e) { parsed = null; }
        if (parsed && (parsed.suggestedSitemap || parsed.finalUrl)) {
          showSyncError(parsed);
        } else {
          toast(err.message, 'error');
        }
      })
      .finally(function() { setBusy(btn, false); });
  });

  document.getElementById('btn-submit').addEventListener('click', function() {
    var btn = this;
    setBusy(btn, true, 'Submitting...');
    api('/sites/' + siteId + '/submit', { method: 'POST' })
      .then(function(r) {
        if (r.status === 'success') toast(r.urlCount + ' URLs submitted');
        else if (r.status === 'no_changes') toast('No new URLs');
        else toast(r.detail || 'Failed', 'error');
        loadUrls();
      })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(btn, false); });
  });

  document.getElementById('btn-reset').addEventListener('click', function() {
    if (!confirm('Reset all URL submission statuses? This marks all URLs as pending.')) return;
    var btn = this;
    setBusy(btn, true, 'Resetting...');
    api('/sites/' + siteId + '/urls/reset', { method: 'POST' })
      .then(function(r) { toast(r.changed + ' URLs reset'); loadUrls(); })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(btn, false); });
  });

  document.getElementById('btn-prune').addEventListener('click', function() {
    if (!confirm('Delete all removed URLs from the database?')) return;
    var btn = this;
    setBusy(btn, true, 'Pruning...');
    api('/sites/' + siteId + '/urls?status=removed', { method: 'DELETE' })
      .then(function(r) { toast(r.deleted + ' URLs pruned'); loadUrls(); })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(btn, false); });
  });

  document.getElementById('verify-key-btn').addEventListener('click', function() {
    var btn = this;
    setBusy(btn, true, 'Checking...');
    api('/sites/' + siteId + '/verify-key', { method: 'POST' })
      .then(function(r) {
        if (r.found) {
          toast('Key verified');
          document.getElementById('key-warning').classList.add('hidden');
          document.getElementById('btn-submit').disabled = false;
        } else {
          toast('Key not found (HTTP ' + r.statusCode + ')', 'error');
        }
      })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(btn, false); });
  });
  // Copy key content / filename
  document.getElementById('copy-key-content').addEventListener('click', function() {
    if (siteData && siteData.apiKey) {
      navigator.clipboard.writeText(siteData.apiKey).then(function() { toast('Key copied'); });
    }
  });
  document.getElementById('copy-key-filename').addEventListener('click', function() {
    if (siteData && siteData.apiKey) {
      navigator.clipboard.writeText(siteData.apiKey + '.txt').then(function() { toast('Filename copied'); });
    }
  });
  document.getElementById('download-key-file').addEventListener('click', function() {
    if (siteData && siteData.apiKey) {
      var blob = new Blob([siteData.apiKey], { type: 'text/plain' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = siteData.apiKey + '.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      toast('Downloaded ' + siteData.apiKey + '.txt');
    }
  });

  // Sitemap dialog: per-sitemap include toggles, counts, clickable links
  function renderSitemapTree(site) {
    var children = site.sitemapChildren || [];
    var openBtn = document.getElementById('btn-sitemaps');
    if (!children.length) {
      openBtn.classList.add('hidden');
      openBtn.classList.remove('inline-flex');
      return;
    }
    openBtn.classList.remove('hidden');
    openBtn.classList.add('inline-flex');
    var excluded = (site.excludedSitemaps || []);
    var included = children.filter(function(child) { return excluded.indexOf(child.url || child) === -1; }).length;
    openBtn.querySelector('.btn-label').textContent = 'Sitemaps (' + included + '/' + children.length + ')';
    var list = document.getElementById('sitemap-list');
    list.innerHTML = children.map(function(child) {
      var loc = child.url || child;
      var isExcluded = excluded.indexOf(loc) !== -1;
      var count = child.count != null ? child.count + ' URLs' : '';
      return '<div class="flex items-center gap-2 rounded-md px-2 py-1.5 text-xs hover:bg-muted/50">' +
        '<input type="checkbox" class="sitemap-toggle rounded shrink-0" data-loc="' + esc(loc) + '" aria-label="Include in sync: ' + esc(loc) + '"' + (isExcluded ? '' : ' checked') + ' />' +
        '<a href="' + esc(loc) + '" target="_blank" rel="noreferrer" class="min-w-0 flex-1 truncate font-mono text-[11px] hover:underline" title="' + esc(loc) + '">' + esc(loc) + '</a>' +
        '<span class="text-muted-foreground shrink-0">' + count + '</span>' +
        '</div>';
    }).join('');
  }

  var sitemapDialog = document.getElementById('sitemap-dialog');
  document.getElementById('btn-sitemaps').addEventListener('click', function() {
    sitemapDialog.showModal();
    document.getElementById('btn-sitemap-close').focus();
  });
  document.getElementById('btn-sitemap-close').addEventListener('click', function() { sitemapDialog.close(); });
  sitemapDialog.addEventListener('click', function(e) { if (e.target === sitemapDialog) sitemapDialog.close(); });

  // Handle sitemap include/exclude toggle
  document.getElementById('sitemap-list').addEventListener('change', function(e) {
    if (!e.target.classList.contains('sitemap-toggle')) return;
    var toggle = e.target;
    var loc = toggle.dataset.loc;
    var include = toggle.checked;
    toggle.disabled = true;
    var excluded = (siteData.excludedSitemaps || []).slice();
    if (include) {
      excluded = excluded.filter(function(u) { return u !== loc; });
    } else {
      if (excluded.indexOf(loc) === -1) excluded.push(loc);
    }
    api('/sites/' + siteId, {
      method: 'PATCH',
      body: JSON.stringify({ excludedSitemaps: excluded })
    }).then(function(updated) {
      siteData.excludedSitemaps = updated.excludedSitemaps || excluded;
      renderSitemapTree(siteData);
      toast(include ? 'Sitemap included' : 'Sitemap excluded');
    }).catch(function(err) {
      toggle.checked = !include;
      toast(err.message, 'error');
    }).finally(function() { toggle.disabled = false; });
  });

  // Selection and bulk actions
  function updateBulkBar() {
    var bar = document.getElementById('bulk-bar');
    var selBtn = document.getElementById('bulk-select-all');
    if (selectedIds.size > 0 || selectAllMatching) {
      bar.classList.remove('hidden');
      if (selectAllMatching) {
        document.getElementById('bulk-count').textContent = 'All ' + filterTotal + ' matching URLs selected';
        selBtn.classList.add('hidden');
      } else {
        document.getElementById('bulk-count').textContent = selectedIds.size + ' selected';
        var pageFull = currentRows.length > 0 && currentRows.every(function(r) { return selectedIds.has(r.id); });
        if (pageFull && filterTotal > currentRows.length) {
          selBtn.textContent = 'Select all ' + filterTotal + ' matching';
          selBtn.classList.remove('hidden');
        } else {
          selBtn.classList.add('hidden');
        }
      }
    } else {
      bar.classList.add('hidden');
    }
    document.getElementById('select-all').checked = currentRows.length > 0 && currentRows.every(function(r) { return selectedIds.has(r.id); });
  }

  document.getElementById('bulk-select-all').addEventListener('click', function() {
    selectAllMatching = true;
    matchFilter = { q: currentQ, status: currentStatus };
    updateBulkBar();
  });

  document.getElementById('url-tbody').addEventListener('change', function(e) {
    if (!e.target.classList.contains('row-select')) return;
    var id = parseInt(e.target.dataset.id);
    if (e.target.checked) selectedIds.add(id); else selectedIds.delete(id);
    selectAllMatching = false;
    updateBulkBar();
  });

  document.getElementById('select-all').addEventListener('change', function() {
    var check = this.checked;
    selectAllMatching = false;
    currentRows.forEach(function(r) { if (check) selectedIds.add(r.id); else selectedIds.delete(r.id); });
    document.querySelectorAll('.row-select').forEach(function(cb) { cb.checked = check; });
    updateBulkBar();
  });

  document.getElementById('bulk-clear').addEventListener('click', function() {
    clearSelection();
  });

  // Collect every matching row across pages (500/request) for cross-page bulk actions
  function collectMatching(field) {
    var out = [];
    var params = 'limit=500&offset=0';
    if (matchFilter.q) params += '&q=' + encodeURIComponent(matchFilter.q);
    if (matchFilter.status !== 'all') params += '&status=' + matchFilter.status;
    function page(offset) {
      var p = params.replace('offset=0', 'offset=' + offset);
      return api('/sites/' + siteId + '/urls?' + p).then(function(data) {
        data.rows.forEach(function(r) { out.push(r[field]); });
        if (out.length < data.total) return page(offset + 500);
        return out;
      });
    }
    return page(0);
  }

  document.getElementById('bulk-submit').addEventListener('click', function() {
    var btn = this;
    setBusy(btn, true, 'Submitting...');
    function done(n) { toast('Submitted ' + n + ' URLs'); clearSelection(); loadUrls(); }
    function fail(err) { toast(err.message, 'error'); }
    if (selectAllMatching) {
      collectMatching('url').then(function(urls) {
        if (!urls.length) { setBusy(btn, false); return; }
        var chunks = [];
        for (var i = 0; i < urls.length; i += 10000) chunks.push(urls.slice(i, i + 10000));
        var chain = Promise.resolve(0);
        chunks.forEach(function(c) {
          chain = chain.then(function(n) {
            return api('/sites/' + siteId + '/submit', { method: 'POST', body: JSON.stringify({ urls: c }) })
              .then(function(r) { return n + (r.urlCount || 0); });
          });
        });
        chain.then(done).catch(fail).finally(function() { setBusy(btn, false); });
      }).catch(function(err) { fail(err); setBusy(btn, false); });
      return;
    }
    var urls = currentRows.filter(function(r) { return selectedIds.has(r.id); }).map(function(r) { return r.url; });
    if (!urls.length) { setBusy(btn, false); return; }
    api('/sites/' + siteId + '/submit', { method: 'POST', body: JSON.stringify({ urls: urls }) })
      .then(function(r) { done(r.urlCount); })
      .catch(fail)
      .finally(function() { setBusy(btn, false); });
  });

  document.getElementById('bulk-delete').addEventListener('click', function() {
    var btn = this;
    if (!confirm('Delete selected URLs?')) return;
    setBusy(btn, true, 'Deleting...');
    function done(n2) { toast('Deleted ' + n2 + ' URLs'); clearSelection(); loadUrls(); }
    function fail(err) { toast(err.message, 'error'); }
    if (selectAllMatching) {
      collectMatching('id').then(function(ids) {
        if (!ids.length) { setBusy(btn, false); return; }
        var chunks = [];
        for (var i = 0; i < ids.length; i += 5000) chunks.push(ids.slice(i, i + 5000));
        var chain = Promise.resolve(0);
        chunks.forEach(function(c) {
          chain = chain.then(function(n3) {
            return api('/sites/' + siteId + '/urls/bulk-delete', { method: 'POST', body: JSON.stringify({ ids: c }) })
              .then(function(r) { return n3 + (r.deleted || 0); });
          });
        });
        chain.then(done).catch(fail).finally(function() { setBusy(btn, false); });
      }).catch(function(err) { fail(err); setBusy(btn, false); });
      return;
    }
    api('/sites/' + siteId + '/urls/bulk-delete', { method: 'POST', body: JSON.stringify({ ids: Array.from(selectedIds) }) })
      .then(function(r) { done(r.deleted); })
      .catch(fail)
      .finally(function() { setBusy(btn, false); });
  });

  // Per-row actions (delegated)
  document.getElementById('url-tbody').addEventListener('click', function(e) {
    var btn = e.target.closest('.row-action-submit, .row-action-copy, .row-action-delete');
    if (!btn) return;
    if (btn.classList.contains('row-action-submit')) {
      var url = btn.dataset.url;
      btn.disabled = true;
      btn.classList.add('opacity-50');
      btn.setAttribute('aria-busy', 'true');
      api('/sites/' + siteId + '/submit', { method: 'POST', body: JSON.stringify({ urls: [url] }) })
        .then(function() { toast('Submitted 1 URL'); loadUrls(); })
        .catch(function(err) { toast(err.message, 'error'); })
        .finally(function() { btn.disabled = false; btn.classList.remove('opacity-50'); btn.removeAttribute('aria-busy'); });
    } else if (btn.classList.contains('row-action-copy')) {
      navigator.clipboard.writeText(btn.dataset.url).then(function() { toast('URL copied'); });
    } else if (btn.classList.contains('row-action-delete')) {
      if (!confirm('Delete this URL?')) return;
      btn.disabled = true;
      btn.classList.add('opacity-50');
      api('/sites/' + siteId + '/urls/bulk-delete', { method: 'POST', body: JSON.stringify({ ids: [parseInt(btn.dataset.id)] }) })
        .then(function() { toast('URL deleted'); loadUrls(); })
        .catch(function(err) { toast(err.message, 'error'); })
        .finally(function() { btn.disabled = false; btn.classList.remove('opacity-50'); });
    }
  });

  // Delete all URLs (danger zone in Site Settings, typed-host confirm)
  document.getElementById('delete-all-confirm').addEventListener('input', function() {
    var ok = siteData && this.value.trim() === siteData.host;
    document.getElementById('btn-delete-all').disabled = !ok;
  });
  document.getElementById('btn-delete-all').addEventListener('click', function() {
    var confirmInput = document.getElementById('delete-all-confirm');
    if (!siteData || confirmInput.value.trim() !== siteData.host) return;
    var btn = this;
    setBusy(btn, true, 'Deleting...');
    api('/sites/' + siteId + '/urls?all=true', { method: 'DELETE' })
      .then(function(r) {
        toast('Deleted ' + r.deleted + ' URLs');
        settingsDialog.close();
        selectedIds.clear();
        selectAllMatching = false;
        loadUrls();
      })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(btn, false); });
  });

  // Site Settings dialog
  var settingsDialog = document.getElementById('site-settings-dialog');
  document.getElementById('btn-site-settings').addEventListener('click', function() {
    if (!siteData) return;
    document.getElementById('edit-name').value = siteData.name;
    document.getElementById('edit-host').value = siteData.host;
    document.getElementById('edit-sitemap').value = siteData.sitemapUrl;
    document.getElementById('edit-key').value = siteData.apiKey || '';
    document.getElementById('edit-level').value = siteData.submissionLevel;
    document.getElementById('edit-cron').value = siteData.cronInterval || 'daily';
    document.getElementById('edit-cron-wrap').classList.toggle('hidden', siteData.submissionLevel !== 'scheduled');
    document.getElementById('delete-all-host').textContent = siteData.host;
    document.getElementById('delete-all-confirm').value = '';
    document.getElementById('btn-delete-all').disabled = true;
    settingsDialog.showModal();
  });

  document.getElementById('edit-level').addEventListener('change', function() {
    document.getElementById('edit-cron-wrap').classList.toggle('hidden', this.value !== 'scheduled');
  });

  document.getElementById('btn-settings-cancel').addEventListener('click', function() { settingsDialog.close(); });
  settingsDialog.addEventListener('click', function(e) { if (e.target === settingsDialog) settingsDialog.close(); });

  document.getElementById('site-settings-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var form = new FormData(this);
    var saveBtn = this.querySelector('button[type="submit"]');
    setBusy(saveBtn, true, 'Saving...');
    api('/sites/' + siteId, {
      method: 'PATCH',
      body: JSON.stringify({
        name: form.get('name'),
        host: String(form.get('host')).replace(/^https?:\/\//, '').replace(/\/.*$/, ''),
        sitemapUrl: form.get('sitemapUrl'),
        apiKey: form.get('apiKey'),
        submissionLevel: form.get('submissionLevel'),
        cronInterval: form.get('cronInterval') || 'daily',
      })
    }).then(function(updated) {
      toast('Site updated');
      settingsDialog.close();
      Object.assign(siteData, updated);
      document.getElementById('site-title').textContent = siteData.name;
      document.getElementById('site-name').textContent = siteData.name;
      document.getElementById('site-host').textContent = siteData.host;
      loadUrls();
    }).catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(saveBtn, false); });
  });

  document.getElementById('btn-delete-site').addEventListener('click', function() {
    if (!confirm('Delete this site and all its URLs? This cannot be undone.')) return;
    var btn = this;
    setBusy(btn, true, 'Deleting...');
    api('/sites/' + siteId, { method: 'DELETE' })
      .then(function() { toast('Site deleted'); window.location.href = '/'; })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(btn, false); });
  });

  // Custom URL dialog
  var customDialog = document.getElementById('custom-url-dialog');
  document.getElementById('btn-custom-url').addEventListener('click', function() {
    document.getElementById('custom-urls-input').value = '';
    customDialog.showModal();
  });
  document.getElementById('btn-custom-cancel').addEventListener('click', function() { customDialog.close(); });
  customDialog.addEventListener('click', function(e) { if (e.target === customDialog) customDialog.close(); });

  document.getElementById('custom-url-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var lines = document.getElementById('custom-urls-input').value.split('\n').map(function(l) { return l.trim(); }).filter(Boolean);
    if (!lines.length) { toast('Enter at least one URL', 'error'); return; }
    var btn = document.getElementById('btn-custom-submit');
    setBusy(btn, true, 'Submitting...');
    api('/sites/' + siteId + '/submit', { method: 'POST', body: JSON.stringify({ urls: lines }) })
      .then(function(r) {
        toast('Submitted ' + r.urlCount + ' URLs');
        customDialog.close();
        loadUrls();
      })
      .catch(function(err) { toast(err.message, 'error'); })
      .finally(function() { setBusy(btn, false); });
  });
})();
</script>
