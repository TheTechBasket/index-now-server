<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Changelog</h1>
    <p class="text-sm text-muted-foreground">Fixes, performance improvements, and new features, release by release.</p>
  </div>

  <% if (changelog.length === 0) { %>
    <p class="text-sm text-muted-foreground">No fix, performance, or feature entries yet.</p>
  <% } %>

  <div class="space-y-4">
    <% changelog.forEach(function(entry) { %>
      <div class="rounded-xl border bg-card shadow-xs">
        <div class="flex items-center justify-between px-6 pt-5 pb-2">
          <h2 class="flex items-center gap-2 text-base font-semibold">
            v<%= entry.version %>
            <% if (entry.version === version) { %>
              <span class="inline-flex items-center rounded-md bg-primary px-1.5 h-4 text-[10px] font-normal text-primary-foreground">current</span>
            <% } %>
          </h2>
          <span class="text-xs text-muted-foreground"><%= entry.date %></span>
        </div>
        <div class="px-6 pb-5 space-y-3">
          <% entry.sections.forEach(function(section) {
            var key = section.heading.toLowerCase();
            var label = key === 'fixed' ? 'Fixed' : key === 'performance' || key === 'perf' ? 'Performance' : key === 'added' ? 'Added' : section.heading;
          %>
            <div>
              <div class="mb-1 flex items-center gap-1.5 text-xs font-semibold text-foreground">
                <% if (key === 'fixed') { %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M3 21c0-2.1 1.7-3.9 3.8-4"/><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"/><path d="M22 13h-4"/><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"/></svg>
                <% } else if (key === 'performance' || key === 'perf') { %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                <% } else { %>
                  <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                <% } %>
                <%= label %>
              </div>
              <ul class="list-disc space-y-1 pl-5 text-sm text-muted-foreground">
                <% section.items.forEach(function(item) { %>
                  <li><%= /docker/i.test(item) ? '🐳 ' + item : item %></li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</div>
