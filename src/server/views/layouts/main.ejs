<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | IndexNow Server</title>
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="stylesheet" href="/assets/globals.css" />
    <style>dialog{margin:auto;max-height:90vh;overflow-y:auto}dialog::backdrop{background:rgba(0,0,0,.5)}</style>
  </head>
  <body class="bg-background text-foreground">
    <div class="mx-auto min-h-svh w-full max-w-5xl px-4 py-6">
      <header class="mb-2 flex flex-wrap items-center justify-between gap-y-2">
        <div class="flex flex-wrap items-center gap-2.5">
          <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-lg">
            <img src="/assets/logo.png" alt="IndexNow Logo" class="size-8 rounded-lg object-cover shadow-sm ring-1 ring-border" />
            <span>IndexNow <span class="font-light text-muted-foreground">Server</span></span>
          </a>
          <% if (version) { %>
            <span class="text-xs font-normal text-muted-foreground">v<%= version %></span>
          <% } %>
          <% if (gh && gh.updateAvailable) { %>
            <a
              href="/changelog"
              class="flex items-center gap-1 rounded-md border border-emerald-500/40 bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400"
              title="v<%= gh.latestVersion %> available (currently v<%= version %>), click for changelog"
            >
              <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
              UPDATE AVAILABLE
            </a>
          <% } %>
        </div>
        <nav class="flex items-center gap-1">
          <% if (gh) { %>
            <a
              href="<%= gh.repoUrl %>"
              target="_blank"
              rel="noreferrer"
              class="flex items-center gap-1 rounded-md border px-1.5 py-1 text-xs text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
              title="View on GitHub"
            >
              <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.26 5.68.42.36.78 1.07.78 2.17 0 1.56-.01 2.82-.01 3.2 0 .31.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z"/></svg>
              <svg class="size-3 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= gh.stars %>
            </a>
          <% } %>
          <a href="/changelog" class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
            Changelog
          </a>
          <a href="/settings" class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            Settings
          </a>
          <% if (authEnabled) { %>
            <form method="POST" action="/api/auth/logout" class="inline">
              <button type="submit" class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground cursor-pointer">
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sign out
              </button>
            </form>
          <% } %>
        </nav>
      </header>

      <% if (devMode || dryRun) { %>
        <div class="mb-6 flex flex-wrap items-center gap-2">
          <% if (devMode) { %>
            <span
              class="inline-flex items-center gap-1 rounded-md border border-slate-500/40 bg-slate-500/10 px-1.5 h-5 text-[10px] font-semibold text-slate-600 dark:text-slate-400"
              title="NODE_ENV is not 'production': running the unbundled dev server, noticeably slower on large sites. Run pnpm build && pnpm start for production performance."
            >
              <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              DEV MODE
            </span>
          <% } %>
          <% if (dryRun) { %>
            <span
              class="inline-flex items-center gap-1 rounded-md border border-amber-500/40 bg-amber-500/10 px-1.5 h-5 text-[10px] font-semibold text-amber-600 dark:text-amber-400"
              title="DRY_RUN=true: IndexNow submissions are simulated, nothing is sent to api.indexnow.org"
            >
              <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
              DRY RUN
            </span>
          <% } %>
        </div>
      <% } %>

      <main>
        <%- body %>
      </main>

      <footer class="mt-20 border-t border-rose-500/20 pt-6 pb-8">
        <!-- Collapsible About IndexNow -->
        <div class="mb-6" id="footer-info">
          <button
            id="footer-toggle"
            class="mb-3 flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
          >
            <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><rect width="7" height="7" x="14" y="3" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/></svg>
            <span>About IndexNow</span>
            <span id="footer-caret" class="text-[10px] transition-transform">&#x25BE;</span>
          </button>
          <div id="footer-cards" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 animate-enter">
            <div class="rounded-xl border bg-card/50 p-5 shadow-xs">
              <div class="mb-3 flex items-center gap-2 text-rose-500 font-semibold text-sm">
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                <span>Search Engines</span>
              </div>
              <ul class="space-y-1.5 text-xs">
                <li class="flex items-center gap-1.5 font-medium"><svg class="size-3.5 text-emerald-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg> Bing &amp; Copilot</li>
                <li class="flex items-center gap-1.5 font-medium"><svg class="size-3.5 text-emerald-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg> Yandex</li>
                <li class="flex items-center gap-1.5 font-medium"><svg class="size-3.5 text-emerald-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg> Naver</li>
                <li class="flex items-center gap-1.5 font-medium"><svg class="size-3.5 text-emerald-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg> Seznam &amp; Yep</li>
              </ul>
            </div>
            <div class="rounded-xl border bg-card/50 p-5 shadow-xs">
              <div class="mb-3 flex items-center gap-2 text-rose-500 font-semibold text-sm">
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                <span>How It Works</span>
              </div>
              <div class="space-y-2 text-xs text-muted-foreground">
                <div class="flex gap-2">
                  <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-rose-500/10 text-rose-500 font-mono font-bold text-[10px]">1</span>
                  <span>Host a <code>&lt;key&gt;.txt</code> file at your domain root</span>
                </div>
                <div class="flex gap-2">
                  <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-rose-500/10 text-rose-500 font-mono font-bold text-[10px]">2</span>
                  <span>Server monitors sitemaps for new/changed URLs</span>
                </div>
                <div class="flex gap-2">
                  <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-rose-500/10 text-rose-500 font-mono font-bold text-[10px]">3</span>
                  <span>URLs submitted to all engines in batches of 10,000</span>
                </div>
              </div>
            </div>
            <div class="rounded-xl border bg-card/50 p-5 shadow-xs sm:col-span-2 lg:col-span-1">
              <div class="mb-3 flex items-center gap-2 text-rose-500 font-semibold text-sm">
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
                <span>Automation</span>
              </div>
              <div class="space-y-1.5 text-xs text-muted-foreground">
                <p><strong class="text-foreground">Webhooks:</strong> Trigger on CMS publish or CI deploy</p>
                <p><strong class="text-foreground">Cron:</strong> Hourly, 6h, daily, weekly, monthly</p>
                <p><strong class="text-foreground">Discord:</strong> Real-time submission alerts</p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-muted-foreground">
          <div class="flex items-center gap-2">
            <span class="inline-flex size-2 rounded-full bg-rose-600"></span>
            <span class="font-semibold text-foreground">IndexNow <span class="text-rose-500 font-bold">Server</span></span>
            <span>&middot; Self-hosted &amp; open-source</span>
          </div>
          <div class="flex items-center gap-4">
            <a href="/" class="hover:text-rose-500 transition-colors">Dashboard</a>
            <a href="/settings" class="hover:text-rose-500 transition-colors">Settings</a>
            <a href="/changelog" class="hover:text-rose-500 transition-colors">Changelog</a>
            <a
              href="https://www.indexnow.org"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1 hover:text-rose-500 transition-colors"
            >
              IndexNow.org
              <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Footer info toggle with localStorage persistence
      (function() {
        var KEY = 'indexnow.footer.dismissed';
        var cards = document.getElementById('footer-cards');
        var caret = document.getElementById('footer-caret');
        var btn = document.getElementById('footer-toggle');
        var dismissed = false;
        try { dismissed = localStorage.getItem(KEY) === '1'; } catch(e) {}
        if (dismissed) {
          cards.style.display = 'none';
          caret.style.transform = '';
        } else {
          caret.style.transform = 'rotate(180deg)';
        }
        btn.addEventListener('click', function() {
          dismissed = !dismissed;
          cards.style.display = dismissed ? 'none' : '';
          caret.style.transform = dismissed ? '' : 'rotate(180deg)';
          try { localStorage.setItem(KEY, dismissed ? '1' : '0'); } catch(e) {}
        });

        // Logout form: use fetch to POST, then redirect
        var logoutForm = document.querySelector('form[action="/api/auth/logout"]');
        if (logoutForm) {
          logoutForm.addEventListener('submit', function(e) {
            e.preventDefault();
            fetch('/api/auth/logout', { method: 'POST' }).then(function() {
              window.location.href = '/login';
            });
          });
        }
      })();
    </script>
  </body>
</html>
