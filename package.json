{
  "name": "index-now-server",
  "version": "0.8.0",
  "description": "Self-hosted IndexNow submission manager: keys, sitemaps, schedules, one dashboard.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --ignore src/client src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "mcp": "node --import tsx src/server/mcp.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.9.0",
    "node-cron": "^4.5.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.1.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
