# Port the app listens on (default 3020)
PORT=3020

# SQLite database file (default ./data/indexnow.db, created automatically)
DATABASE_PATH=./data/indexnow.db

# === Auth (optional) ===
#
# Auth is a simple login gate over the dashboard for when you host it publicly.
# It does NOT tie your data to any user — sites and URLs live independently, so you
# can change the admin email/password here any time without touching your data.
#
# To DISABLE auth entirely (local / trusted network only), set AUTH_ENABLED=false.
# When AUTH_ENABLED=true you must set BOTH admin vars below and AUTH_SECRET.

# Gate the dashboard behind a login (default true).
AUTH_ENABLED=true

# The single admin login (email + password).
# Use a STRONG password (12+ chars, mix of letters/numbers/symbols).
# We log a warning if it looks weak but never block you.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to sign login session cookies. Required when auth is enabled.
# Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: Discord webhook URL for notifications (can also be set via the dashboard)
# DISCORD_WEBHOOK_URL=
