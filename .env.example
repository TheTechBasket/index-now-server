# === Core (required) ===
PORT=3020 # app listen port
DATABASE_PATH=./data/indexnow.db # sqlite file, auto-created

# === Auth (required if AUTH_ENABLED=true) ===
AUTH_ENABLED=true # set false to disable login gate (trusted network only)
AUTH_SECRET= # openssl rand -base64 32 — signs session cookies
ADMIN_EMAIL= # admin login email
ADMIN_PASSWORD= # admin login password (12+ chars recommended)

# === Notifications (optional) ===
# DISCORD_WEBHOOK_URL= # discord webhook for success/error alerts, also set via dashboard

# === Cron tuning (optional) ===
# CRON_INTER_SITE_DELAY_MS=2000 # base gap between sites in scheduled tick
# CRON_JITTER_MAX_MS=5000 # per-site jitter via id hash, spreads burst
# CRON_BACKOFF_403_MS=10000 # extra delay after 403/429 before next site

# === Sitemap tuning (optional) ===
# SITEMAP_MAX_RETRIES=3 # retries on 403/429/5xx
# SITEMAP_BASE_BACKOFF_MS=1500 # base backoff, respects Retry-After header
# SITEMAP_CHILD_CONCURRENCY=3 # concurrent fetches for sitemap index children
# SITEMAP_CHILD_GAP_MS=400 # gap between child fetches
